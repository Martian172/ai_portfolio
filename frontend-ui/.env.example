# Optional. Leave unset when the API is served from the same domain under /api
# (Vercel in production; the Vite dev server proxies /api to http://127.0.0.1:8000 locally).
# Set it only if the backend runs on a different domain, e.g. VITE_API_URL=https://api.example.com
#
# Everything here is PUBLIC: Vite bakes VITE_* values into the JavaScript every visitor downloads.
# Never put API keys or tokens in this file.
# VITE_API_URL=
