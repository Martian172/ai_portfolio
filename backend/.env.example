# Copy this file to .env in the project root (next to the backend/ folder) and fill in your values.
# Never commit the real .env file.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Your GitHub username (not the profile URL). Public repositories are fetched automatically.
GITHUB_USERNAME=martian172

# Optional: a GitHub personal access token with public read access gives a higher API rate limit.
# Never put this value in frontend-ui/.env or in React code.
GITHUB_TOKEN=

# Path to the resume PDF the AI reads. Relative paths are resolved from the project root.
RESUME_PATH=ansh.pdf

# ---- Security settings ----
# Comma-separated list of sites allowed to call the API from a browser (your deployed frontend).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only on platforms that set X-Forwarded-For themselves (Vercel, Render). Otherwise false.
TRUST_PROXY=false
# Interactive API docs at /docs. Keep false in production.
ENABLE_DOCS=false
# Chat abuse limits (protect your Groq quota).
CHAT_LIMIT_PER_MINUTE=6
CHAT_LIMIT_PER_DAY=60
CHAT_GLOBAL_LIMIT_PER_DAY=1500

# ---- Contact form (/contact page) ----
# Free API key from https://resend.com/api-keys. Server-side only, never in frontend code.
RESEND_API_KEY=your_resend_api_key_here
# Inbox that receives messages. With Resend's default test sender this must be the email
# address you signed up to Resend with (until you verify your own domain there).
CONTACT_TO_EMAIL=you@example.com
# Optional: after verifying a domain in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
CONTACT_LIMIT_PER_HOUR=3
CONTACT_LIMIT_PER_DAY=6
CONTACT_GLOBAL_LIMIT_PER_DAY=100
